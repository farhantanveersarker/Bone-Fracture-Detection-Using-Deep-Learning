# Copy this file to .env and fill in your own values.

# Secret used to sign login sessions:
#   python -c "import secrets; print(secrets.token_hex(32))"
FRACTUREAI_SECRET_KEY=change-me-to-a-long-random-string

# Port the development server listens on (default 5000)
PORT=5000

# Optional: folder for the SQLite database (fractureai.db) and uploads.
# Defaults to the project root.
# FRACTUREAI_DATA_DIR=/path/to/data
